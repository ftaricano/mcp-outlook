{
  "name": "mcp-outlook",
  "version": "2.3.0",
  "description": "MCP server for Microsoft Outlook and Exchange via Microsoft Graph",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist",
    ".codex-plugin",
    ".mcp.json",
    "assets",
    "scripts/outlook.js",
    "scripts/generate-app-manifest.js",
    "scripts/plugin-smoke-test.js",
    "scripts/plugin-http-smoke.js",
    "scripts/lib",
    "docs/specs",
    "README.md",
    "PRIVACY.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "bin": {
    "outlook": "./scripts/outlook.js"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "postcss": "^8.5.23"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "start:plugin": "node dist/plugin/stdio.js",
    "start:http": "node dist/plugin/http.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.js\" \"*.md\" \"docs/**/*.md\" \".github/**/*.yml\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.js\" \"*.md\" \"docs/**/*.md\" \".github/**/*.yml\" \"*.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-test.js",
    "smoke:plugin": "node scripts/plugin-smoke-test.js",
    "smoke:http": "node scripts/plugin-http-smoke.js",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke && npm run smoke:plugin && npm run smoke:http",
    "audit:prod": "npm audit --omit=dev",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "email",
    "exchange",
    "microsoft-graph",
    "model-context-protocol",
    "outlook",
    "typescript"
  ],
  "author": "Fernando Taricano",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ftaricano/mcp-outlook.git"
  },
  "bugs": {
    "url": "https://github.com/ftaricano/mcp-outlook/issues"
  },
  "homepage": "https://github.com/ftaricano/mcp-outlook#readme",
  "dependencies": {
    "@azure/msal-node": "^5.4.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "unzipper": "^0.12.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/unzipper": "^0.10.11",
    "@types/yazl": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "yazl": "^3.3.1"
  }
}
