# ========================================
# mcp-outlook - Environment Variables
# ========================================

# -----------------------------------------
# Azure AD (REQUIRED)
# -----------------------------------------
# Get these values from Azure Portal → App Registrations.
# Authentication uses the OAuth2 client-credentials flow (MSAL).
MICROSOFT_GRAPH_CLIENT_ID=your_client_id_here
MICROSOFT_GRAPH_CLIENT_SECRET=your_client_secret_here
MICROSOFT_GRAPH_TENANT_ID=your_tenant_id_here

# -----------------------------------------
# Mailbox target (OPTIONAL, recommended for app-permission setups)
# -----------------------------------------
# When the app uses application permissions, Microsoft Graph does NOT
# infer a mailbox from the client credential. Set TARGET_USER_EMAIL to
# the mailbox the server should act on.
TARGET_USER_EMAIL=

# -----------------------------------------
# Logging
# -----------------------------------------
# LOG_LEVEL controls stdout logging. Values: debug | info | warn | error
LOG_LEVEL=info

# MCP_SERVER_NAME / MCP_SERVER_VERSION show up in MCP handshake + logs.
# Defaults applied by the runtime if unset.
# MCP_SERVER_NAME=mcp-outlook
# MCP_SERVER_VERSION=2.3.0

# macOS only: when env vars are missing, the server can read matching
# Keychain items named "<prefix>::<VARIABLE_NAME>".
# Default: mcp-outlook
OUTLOOK_KEYCHAIN_PREFIX=mcp-outlook

# Optional migration aliases for existing Keychain service names. Each value
# is a comma-separated list checked after the prefix-based service name.
# OUTLOOK_KEYCHAIN_MICROSOFT_GRAPH_CLIENT_ID_SERVICES=old-client-id-service
# OUTLOOK_KEYCHAIN_MICROSOFT_GRAPH_CLIENT_SECRET_SERVICES=old-secret-service
# OUTLOOK_KEYCHAIN_MICROSOFT_GRAPH_TENANT_ID_SERVICES=old-tenant-service
# OUTLOOK_KEYCHAIN_TARGET_USER_EMAIL_SERVICES=old-mailbox-service

# NODE_ENV: development | production | test
NODE_ENV=production

# -----------------------------------------
# CLI state and sanitized learning telemetry
# -----------------------------------------
# Persistent saved searches and metadata-only runs.jsonl live here.
# Default: $XDG_STATE_HOME/mcp-outlook or ~/.local/state/mcp-outlook.
OUTLOOK_STATE_DIR=

# Set to 0 to disable sanitized CLI run telemetry globally.
# Individual commands can use --no-journal.
OUTLOOK_JOURNAL=1

# -----------------------------------------
# Multi-mailbox plugin (11 read-only tools by default, 16 with writes enabled)
# -----------------------------------------
# Absolute path to a private JSON configuration file (mode 0600 on POSIX).
# Default: ~/.config/mcp-outlook/plugin.json
# The file contains only mailbox aliases, addresses, and server-side limits.
OUTLOOK_PLUGIN_CONFIG=

# Optional generic search-memory YAML. Keep it private (mode 0600) and outside
# this repository. When set, this path overrides searchMemoryPath in plugin.json.
PLUGIN_SEARCH_MEMORY_PATH=

# Fail-closed write toggle. false always disables the 5 write tools; true enables
# them. Unset/empty delegates to allowWrites in plugin.json (default false).
# Any other value is rejected at startup.
PLUGIN_ALLOW_WRITES=false

# Independent fail-closed local handoff toggle. true registers two tools that
# can atomically place one bounded attachment in a fixed private local store.
# It does not enable any mailbox-write tool. Any other value is rejected.
PLUGIN_ALLOW_LOCAL_HANDOFFS=false

# The built-in HTTP server is loopback-only. A bearer is optional locally and
# checked before the JSON body is parsed.
OUTLOOK_HTTP_HOST=127.0.0.1
OUTLOOK_HTTP_PORT=3010
OUTLOOK_HTTP_BEARER_TOKEN=

# -----------------------------------------
# Filesystem allowlist (security-critical)
# -----------------------------------------
# DOWNLOAD_DIR — directory where the server is allowed to WRITE files
# (attachment downloads, exported emails, etc.). Everything outside this
# directory is rejected by pathGuard.
# Defaults to ~/Downloads/mcp-outlook-attachments if unset.
DOWNLOAD_DIR=

# MCP_EMAIL_UPLOAD_DIRS — colon-separated list of directories the server
# is allowed to READ from when encoding a local file as an email
# attachment (send_email_with_file, encode_file_for_attachment, etc.).
# If unset, reads fall back to DOWNLOAD_DIR.
#
# Example:
#   MCP_EMAIL_UPLOAD_DIRS=/Users/me/Documents:/Users/me/Work/outgoing
#
# Any path outside this allowlist — including symlinks that resolve
# outside it and files in secret-bearing directories (.ssh, .aws,
# .gnupg, .env files, *.pem/*.key, etc.) — is rejected.
MCP_EMAIL_UPLOAD_DIRS=

# ========================================
# Azure AD permissions required
# ========================================
# Application Permissions (client-credentials flow):
# Original 40-tool server:
#   - Mail.ReadWrite      (required)
#   - Mail.Send           (only for send_email/reply_to_email)
# Multi-mailbox plugin:
#   - Mail.Read           (11 read-only tools, recommended separate app registration)
#   - Mail.ReadWrite      (required only when the 5 write tools are enabled)
#   - Mail.Send           (never required; the plugin cannot send)
#   - User.Read.All       (optional; enables list_users)
#
# After configuring, click "Grant admin consent" in Azure Portal.

# ========================================
# Setup
# ========================================
# 1. cp .env.example .env
# 2. Fill in Azure AD credentials + TARGET_USER_EMAIL.
# 3. Set DOWNLOAD_DIR and MCP_EMAIL_UPLOAD_DIRS to the directories the
#    server is allowed to touch.
# 4. npm run build && npm start
